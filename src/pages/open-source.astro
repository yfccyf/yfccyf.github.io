---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Open Source | Yifan Cheng">
  <section class="hero">
    <p class="eyebrow">Open Source</p>
    <h1>Public tools, examples, and contributions.</h1>
    <p class="lead">
      A record of open-source projects and contributions related to machine learning engineering, AI infrastructure, and
      production reliability.
    </p>
  </section>

  <section class="section">
    <h2>GitHub</h2>
    <p>
      My GitHub profile is available at <a href="https://github.com/yfccyf">github.com/yfccyf</a>.
    </p>
  </section>

  <section class="section">
    <h2>Featured Repositories</h2>
    <ul class="item-list">
      <li>
        <h3>
          <a href="https://github.com/yfccyf/agent-trace-eval">agent-trace-eval</a>
        </h3>
        <p class="meta">
          Golden trace regression evaluation for tool-using AI agents. Includes matchers for tool calls, arguments,
          ordering, handoffs, and recovery decisions, plus a CLI for CI release gates.
        </p>
        <p class="meta">
          <a href="https://github.com/yfccyf/agent-trace-eval">Repository</a>
          ·
          <a href="https://pypi.org/project/agent-trace-eval/">PyPI</a>
          ·
          <a href="https://github.com/yfccyf/agent-trace-eval#readme">Documentation</a>
        </p>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>Repository Standards</h2>
    <div class="grid">
      <article class="card">
        <h3>Clear Documentation</h3>
        <p>Each project should include a concise README, installation instructions, examples, and design notes.</p>
      </article>
      <article class="card">
        <h3>Reproducible Examples</h3>
        <p>Small, runnable examples make technical ideas easier to evaluate, reuse, and cite.</p>
      </article>
      <article class="card">
        <h3>Adoption Signals</h3>
        <p>Stars, forks, issues, external mentions, downloads, and dependent projects will be tracked over time.</p>
      </article>
    </div>
  </section>
</BaseLayout>
