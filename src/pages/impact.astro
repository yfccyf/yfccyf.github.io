---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Impact | Yifan Cheng">
  <section class="hero">
    <p class="eyebrow">Impact</p>
    <h1>A running record of external influence.</h1>
    <p class="lead">
      This page is designed to track public evidence that technical work is useful beyond a single organization:
      adoption, citations, talks, references, community usage, and measurable outcomes.
    </p>
  </section>

  <section class="section">
    <h2>Evidence Categories</h2>
    <div class="grid">
      <article class="card">
        <h3>Adoption</h3>
        <p>Repository stars, forks, downloads, dependent projects, issue discussions, and community contributions.</p>
      </article>
      <article class="card">
        <h3>Citations</h3>
        <p>External articles, documentation links, conference materials, newsletters, and references by other engineers.</p>
      </article>
      <article class="card">
        <h3>Presentations</h3>
        <p>Talks, webinars, panels, demos, slides, recordings, and meetup sessions.</p>
      </article>
      <article class="card">
        <h3>Technical Outcomes</h3>
        <p>Documented improvements in evaluation speed, release confidence, reliability, debugging, or governance.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2>Current Status</h2>
    <p>
      This page will be updated as public projects, writing, talks, and external references are published.
    </p>
  </section>
</BaseLayout>
