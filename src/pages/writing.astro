---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Writing | Yifan Cheng">
  <section class="hero">
    <p class="eyebrow">Writing</p>
    <h1>Technical notes on reliable AI systems.</h1>
    <p class="lead">
      Essays, architecture notes, and implementation memos on evaluation, observability, governance, and production
      infrastructure for AI agents.
    </p>
  </section>

  <section class="section">
    <h2>Draft Topics</h2>
    <ul class="item-list">
      <li>
        <h3>Reusable Infrastructure for Enterprise AI Agents</h3>
        <p class="meta">A technical memo on moving AI agents from prototypes to reliable production systems.</p>
      </li>
      <li>
        <h3>Evaluation Harnesses for Multi-Step Agent Workflows</h3>
        <p class="meta">How to test agent behavior, detect regressions, and define release criteria.</p>
      </li>
      <li>
        <h3>Observability Patterns for Tool-Using AI Agents</h3>
        <p class="meta">Trace schemas and debugging workflows for complex agent execution paths.</p>
      </li>
      <li>
        <h3>Governance-First Design for Enterprise Agent Systems</h3>
        <p class="meta">Practical controls for policy-aware tool use, auditability, and operational trust.</p>
      </li>
    </ul>
  </section>
</BaseLayout>
