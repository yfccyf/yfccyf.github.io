---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const essays = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Writing | Yifan Cheng">
  <section class="hero">
    <p class="eyebrow">Writing</p>
    <h1>Technical notes on reliable AI systems.</h1>
    <p class="lead">
      Essays, architecture notes, and implementation memos on evaluation, observability, governance, and production
      infrastructure for AI agents.
    </p>
  </section>

  <section class="section">
    <h2>Essays</h2>
    {
      essays.length > 0 ? (
        <ul class="item-list">
          {essays.map((essay) => (
            <li>
              <h3>
                <a href={`/writing/${essay.id}/`}>{essay.data.title}</a>
              </h3>
              <p>{essay.data.description}</p>
              <p class="meta">
                {essay.data.date.toLocaleDateString("en", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
                {essay.data.tags.length > 0 && ` · ${essay.data.tags.join(", ")}`}
              </p>
              <p class="read-more">
                <a href={`/writing/${essay.id}/`}>Read essay</a>
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p>Essays will appear here as Markdown files are added to <code>src/content/writing</code>.</p>
      )
    }
  </section>
</BaseLayout>
