---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Talks | Yifan Cheng">
  <section class="hero">
    <p class="eyebrow">Talks</p>
    <h1>Presentations, demos, and public technical discussions.</h1>
    <p class="lead">
      This page will collect conference talks, meetup presentations, webinars, slides, recordings, and demos connected
      to enterprise AI infrastructure and applied machine learning.
    </p>
  </section>

  <section class="section">
    <h2>Potential Topics</h2>
    <ul class="item-list">
      <li>
        <h3>How to Evaluate Production AI Agents</h3>
        <p class="meta">A practical talk on test sets, trace review, regression detection, and release confidence.</p>
      </li>
      <li>
        <h3>Observability for Tool-Using LLM Applications</h3>
        <p class="meta">A walkthrough of agent traces, metrics, debugging, and operational feedback loops.</p>
      </li>
      <li>
        <h3>From Prototype to Governed Enterprise Agent</h3>
        <p class="meta">Design patterns for policy-aware execution, controlled tool use, and auditable deployment.</p>
      </li>
    </ul>
  </section>
</BaseLayout>
